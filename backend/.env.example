# Dashboard > Project Settings > Database > Connection string (URI).
# Used by `npm run migrate`, admin account management and the ML worker queue.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres
ML_SERVICE_URL=http://127.0.0.1:8000
CORS_ORIGIN=*

# ML worker (optional overrides)
# ML_DATA_DIR=ml/data
# ML_CACHE_DIR=ml/cache
# ML_ARTIFACTS_DIR=ml/artifacts
# ML_ARTIFACT_BUCKET=ml-models      # Storage mirror, only when the service key is set
# ML_STALE_JOB_SECONDS=600          # a running job without heartbeat is resumed after this
